<Window x:Class="CodexQuotaWidget.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexQuotaWidget.App"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:modules="clr-namespace:CodexQuotaWidget.App.Modules"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=modules:UsageModule, IsDesignTimeCreatable=False}"
        Title="GPT 额度"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        automation:AutomationProperties.Name="{Binding WeeklyRemainingAutomationText}"
        automation:AutomationProperties.HelpText="{Binding StatusText}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <local:TaskbarCapsuleHostView x:Name="Readout" Cursor="SizeAll"
        MouseLeftButtonDown="DragSurface_MouseLeftButtonDown" />
</Window>
